{
  "id": "tundra-adventure",
  "name": "Tundra Adventure",
  "img": "/images/events/tundra-adventure.png",
  "category": "solo",
  "description": "Roll dice to move around a board for rewards and Adventure Coins, which you spend in the Adventure Caravan. The event has four parts: Tundra Adventure, Adventurer Drill, Odyssey of Adventure, and Adventure Caravan.",
  "frequency": "Irregular, set by the developers",
  "duration": "7 days. The Adventure Caravan shop lasts 8 days.",
  "phases": [
    {
      "name": "Tundra Adventure",
      "description": "Use Common Dice (a random 1 to 6) or Illusion Dice (a 1 to 6 you choose). A normal roll uses 1 Common Die and a quintuple roll uses 5. Tiles: Starting, Treasure, Event, and Item. Unused Common Dice become a 10K resource chest at the end, and unused Illusion Dice become 100 Gems. A blue chest appears on a random tile and moves once you step on it."
    },
    {
      "name": "Adventurer Drill",
      "description": "Daily missions (reset at 00:00 UTC) give Adventure Points and rewards. Treasure Hunt Tomes (price level 3) double the daily mission rewards and unlock special rewards. Buy it on day 1 if at all."
    },
    {
      "name": "Odyssey of Adventure",
      "description": "A 7-day puzzle board of 15 missions. Each row gives a chest and each column gives a chest. Finishing the board gives the Adventurer\u2019s Chest."
    },
    {
      "name": "Adventure Caravan",
      "description": "The shop where you spend Adventure Coins. It lasts 8 days and its Mythic General Hero Shards reset on day 8. Unused Adventure Coins turn into 1K resources at the end. Two limited city skins and two limited march skins change each time the event appears."
    }
  ],
