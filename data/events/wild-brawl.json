{
  "id": "wild-brawl",
  "name": "Wild Brawl",
  "img": "/images/events/wild-brawl.png",
  "category": "solo",
  "description": "A free-for-all where 10 chiefs fight in a match to earn points from buildings, supply crates, and airdropped items.",
  "frequency": "Recurring, once the state has reached the required age",
  "duration": "2 days",
  "requirements": [
    "Furnace Lv. 25 or higher.",
    "Not available before Hero Generation 3.",
    "You must have no troops scouting or on expedition, no barricades burning, and no reinforcements in your Embassy."
  ],
  "phases": [
    {
      "name": "Matchmaking",
      "description": "4 periods each day, 2 hours each. Same-Gen mode matches chiefs of one hero generation. Cross-Gen mode matches chiefs from all states. A match starts when 10 chiefs are ready. Each chief can play 10 matches in the whole event."
    },
    {
      "name": "Preparation",
      "description": "The first 30 seconds of a 10-minute match."
    },
    {
      "name": "Battle",
      "description": "9 minutes 30 seconds. 4 buildings can be captured: the Twilight Citadel in the center, worth the most points (7,000 for the first control and +2,100 a minute after), and 3 Boulder Fortresses (2,000 for the first control and +600 a minute after). A building is held after 10 seconds. 30 seconds in, 3 supply trucks arrive every minute with strategic supply crates. 1 minute 30 seconds in, item crates are airdropped every 2 minutes."
    }
  ],
