{
  "id": "tundra-games",
  "name": "Tundra Games",
  "img": "/images/events/tundra-games.png",
  "category": "solo",
  "description": "A set of seven mini games and tasks with rewards. Players punch Brawler Buddies with Energized Bread.",
  "frequency": "Irregular",
  "phases": [
    {
      "name": "Camp Frostpunch",
      "description": "The main part. Use Energized Bread to punch Brawler Buddies. Each Brawler Buddy you defeat has a 20% chance to summon the Arctic Crusher, which can be hit 3 to 15 times, with 10% of appearances allowing 10 or more hits. Each punch gives 2 Frostpunch Points. The chance of the grand prize on 10 or more hits is about 0.06%."
    },
    {
      "name": "Whirlwind Wallop",
      "description": "The milestone track for Frostpunch Points. The first tier is free. The second and third tiers need paid upgrades."
    },
    {
      "name": "Kitty Rescue",
      "description": "A reflex game with the Mythic hero Reina. Throw kunai at a spinning ice block without hitting kunai already stuck in it. Cleared stages give rewards, including Energized Bread."
    },
    {
      "name": "King of Treasure",
      "description": "7 one-day stages: Power Boost, Beast Slay, Hero Development, Train Troops, Hero Gear, Resource Gathering, and Chief Gear. You earn points for each stage, claim milestones, get stage ranking rewards each day, and total ranking rewards at the end."
    },
    {
      "name": "Snowcapped Symphony",
      "description": "A board of missions. Finishing a row or column gives a Stage Chest, and finishing the board gives the Snowpeak Trove."
    },
    {
      "name": "Top-up Benefits",
      "description": "Milestones unlocked by buying Gems during the event."
    },
    {
      "name": "Supply Station",
      "description": "Ways to get Energized Bread: spending Gems, using speedups, gathering resources (limit 3,000), and defeating Beasts (limit 7,000). A Longshot Dynamo Pack gives more."
    }
  ],
  "rewards": [
    {
