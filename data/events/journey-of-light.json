  "img": "/images/events/journey-of-light.png",
  "category": "solo",
  "description": "Send aircraft on 8-hour flights to get Radiance Treasure chests, then open or combine them for hero gear and Mythic hero shards.",
  "frequency": "Irregular",
  "duration": "5 days",
  "phases": [
    {
      "name": "Flights",
      "description": "Each flight takes 8 hours. A flight gives a Common Radiance Treasure with a 90% chance or a Premium Radiance Treasure with a 10% chance. The first flight slot is free, the second costs 2,000 Gems, the third 10,000 Gems, and the fourth comes with a 5 USD pack."
    },
    {
      "name": "Combine treasures",
      "description": "3 Common chests combine into 1 Premium chest. 3 Premium chests combine into 1 Exquisite chest (75%) or 1 Dazzling chest (25%). Unopened chests are opened automatically when the event ends."
    }
