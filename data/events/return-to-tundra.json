{
  "id": "return-to-tundra",
  "name": "Return to Tundra",
  "img": "/images/events/return-to-tundra.png",
  "category": "solo",
  "description": "An event of five mini events for players who stopped playing for a while and come back.",
  "requirements": [
    "The state must have been in its hero generation for at least 14 days.",
    "Furnace Level 7 or higher.",
    "You can see it more than once for each generation."
  ],
  "phases": [
    {
      "name": "Journey Back",
      "description": "For players offline 10 days or more. Lasts 10 days. Log in for 7 days to collect the heroes of the current generation and speedups."
    },
    {
      "name": "Dawning Return",
      "description": "For players offline 10 days or more. Lasts 10 days. Collect Snowflake Seals by doing your dailies (20, 30, 40, 50, 60, 70, and 80, so 350 a day, 3,500 over 10 days) for rewards. You can buy 2 extra passes."
    },
    {
      "name": "Homeward Verses",
      "description": "For players offline 16 days or more. Lasts 10 days. Missions give feathers for milestone Ink Pot rewards."
    },
    {
      "name": "Dawn\u2019s Boost",
      "description": "For players offline 16 days or more. Lasts 10 days. Gives a boost for your city. The Intel boost does not double Crystallite Cores in Flame and Fang."
    },
    {
      "name": "Begin Again",
      "description": "For players offline 31 days or more. Lasts 10 days. Create a character in another state through the event to get rewards directly on that character."
    }
  ],
