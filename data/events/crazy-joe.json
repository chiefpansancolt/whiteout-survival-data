{
  "id": "crazy-joe",
  "name": "Crazy Joe",
  "img": "/images/events/crazy-joe.png",
  "category": "alliance",
  "description": "Players earn points by sending reinforcements to alliance partners, who do the same in return. A system camp attacks cities in 20 waves: 2 target headquarters and 18 target furnaces. There are 21 difficulty levels, and shields are ineffective.",
  "frequency": "Tuesday and Thursday during the SvS, KOI, or HoC week.",
  "duration": "About 40 minutes",
  "requirements": [
    "At least one headquarters built to launch the event",
    "R4 or R5 can schedule or manually activate the event and select the spawn headquarters",
    "Only one Crazy Joe event per alliance at a time",
    "To unlock a new difficulty, complete the previous difficulty at least once and reach the Alliance Defense Points listed for the new one"
  ],
