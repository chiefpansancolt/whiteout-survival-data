{
  "id": "icefire-warhymn-league",
  "name": "Icefire Warhymn League",
  "img": "/images/events/icefire-warhymn-league.png",
  "category": "solo",
  "description": "A week-long solo tournament in a half-ice, half-fire arena. Chiefs battle through the Qualifier, Elimination, and Pinnacle phases to be crowned the season champion. No real troops are lost in battles.",
  "frequency": "One season per week, Sunday to Saturday",
  "duration": "Competition runs Monday to Saturday, after a 24-hour Preview Phase on Sunday",
  "requirements": [
    "Furnace level 30 or higher",
    "The event begins in a state two weeks after Generation 4 heroes unlock there"
  ],
  "phases": [
    {
      "name": "Preview",
      "description": "Sunday, 24 hours"
    },
    {
      "name": "Sign-Up",
      "description": "Monday and Tuesday, 48 hours. Set up 3 formations, each with a hero and troops. A chief with no lineup loses automatically at the start of battle."
    },
    {
      "name": "Qualifier",
      "description": "Wednesday, up to 10 rounds between 12:00 and 21:00 UTC. Chiefs are ranked by points, and 3 defeats eliminate a chief. The Top 64 in each Zone advance. The lineup is locked until the phase ends."
    },
    {
      "name": "Elimination",
      "description": "Thursday, best of 3. Round 1 at 10:00 UTC (Top 64 to Top 32), Round 2 at 16:00 UTC (Top 32 to Top 16), and Round 3 at 22:00 UTC (Top 16 to Top 8)."
    },
    {
      "name": "Pinnacle",
      "description": "Friday and Saturday, best of 3. Top 8 on Friday at 11:00 UTC, Top 4 on Friday at 23:00 UTC, and the Championship Final on Saturday at 11:00 UTC. Lineups lock one minute before each round."
    }
  ],
  "rewards": [
    {
      "name": "Warhymn Testament",
      "itemId": "warhymn-testament",
      "amount": 50,
      "note": "Per Qualifier defeat"
    },
    {
      "name": "Treasure Box",
      "itemId": "treasure-box",
      "amount": 1,
      "note": "Per Qualifier defeat"
    },
    {
      "name": "Enhancement XP Component (10)",
      "itemId": "enhancement-xp-component",
      "amount": 5,
      "note": "Per Qualifier defeat"
    },
    {
      "name": "Warhymn Testament",
      "itemId": "warhymn-testament",
      "amount": 100,
      "note": "Win-count chest"
    },
    {
      "name": "Lucky Hero Gear Chest",
      "itemId": "lucky-hero-gear-chest",
      "amount": 1,
      "note": "Win-count chest"
    },
    {
      "name": "Treasure Box",
      "itemId": "treasure-box",
      "amount": 1,
      "note": "Win-count chest"
    },
    {
      "name": "Enhancement XP Component (100)",
      "itemId": "enhancement-xp-component",
      "amount": 1,
      "note": "Win-count chest"
    },
    {
      "name": "State rewards",
      "note": "Given for a Top 16 competitor from your State if you belong to that State, logged in during the event, and have Furnace Level 20 or higher. After a State transfer, the rewards go to the State you belonged to before. Delivered by mail."
    },
    {
      "name": "Warhymn Testament",
      "itemId": "warhymn-testament",
      "note": "Prediction: back one contender before the match begins. A correct pick returns 2 times the Testaments used. A wrong pick returns them all. Open from Elimination Round 2. A pick cannot be canceled and only chiefs in your Zone can be picked. The wiki gives up to 5 entries of 200 Testaments for each matchup, and another guide gives a maximum stake of 200 for each match."
    }
  ],
  "tips": [
    "Set up your squad lineup before the Qualifier phase locks it.",
    "Automatic troop filling needs an initial lineup.",
    "Qualifier ranking uses both wins and a power-based score.",
    "Collect match rewards from mail and win-count chests separately.",
    "Check in-game times against UTC to avoid scheduling mistakes.",
    "Warhymn Testaments carry over between seasons.",
    "Mail reward expiry differs from currency expiry.",
    "Check current reward and shop values in-game before exchanging.",
    "Matchmaking first considers the age of your Region, then divides Regions into Zones. Only the Top 64 chiefs in your Zone appear in the event rankings.",
    "No real troops are lost, so use the event to test formations.",
    "Build three formations that can win. Best-of-3 rounds need two wins, so one very strong formation is not enough.",
    "A 50% Infantry, 20% Lancer, 30% Marksman ratio is a neutral starting point and not an official rule.",
    "These apply in battle: troops, heroes, hero gear and exclusive gear, pets, Chief Gear, Chief Charms, research, Fire Crystal Tech, Flame Tech, Alliance Tech, Daybreak Island, skins, VIP, buildings, and Expert attributes.",
    "These do not apply: City War buffs, Positions, President Skills, Domain buffs, and buffs for attacking or defending a city.",
    "Each League Mission has 7 levels, and every level gives the same rewards. The requirement of level N is N times the requirement of level 1. The login mission needs 1 more day for each level.",
    "The League Shop has 16 offers, read from in-game screenshots."
  ],
